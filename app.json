{
  "expo": {
    "name": "SnitchDog",
    "slug": "snitchdog",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "snitchdog",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FBFAF8",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ammanchuhan.snitchdog",
      "buildNumber": "1",
      "userInterfaceStyle": "automatic",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ammanchuhan.snitchdog",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0E1013"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FBFAF8",
          "dark": {
            "backgroundColor": "#121211"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "SnitchDog takes a photo of the scale each time you weigh in, so the number is backed by something real.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/withSceneLifecycle"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
