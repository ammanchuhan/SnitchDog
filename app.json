{
  "expo": {
    "name": "SnitchDog",
    "slug": "snitchdog",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "snitchdog",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FBFAF8",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ammanchuhan.snitchdog",
      "buildNumber": "1",
      "userInterfaceStyle": "automatic",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ammanchuhan.snitchdog",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0E1013"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FBFAF8",
          "dark": {
            "backgroundColor": "#121211"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "SnitchDog reads the number off a photo of your scale, then deletes the photo. Your weekly mirror photo stays on this phone.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SnitchDog uses your location to find your gym when you set up your plan.",
          "locationAlwaysAndWhenInUsePermission": "SnitchDog checks whether you're at your gym on workout days, so workouts count without you tapping anything. Only \"arrived\" and \"left\" are worked out, on this phone; your location never leaves it.",
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "./plugins/withSceneLifecycle",
      "expo-maps"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
