# Postgres (Neon works well on Vercel's free tier)
DATABASE_URL=postgres://...

# @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=123456:ABC...
# Any random string; Telegram echoes it back on every webhook call
TELEGRAM_WEBHOOK_SECRET=

# Written check-ins fall back to templates without this
ANTHROPIC_API_KEY=sk-ant-...

# Vercel sets this automatically for cron; set it locally to protect /api/tick
CRON_SECRET=

# Minutes between the rungs of the ladder: nudge, final warning, tell the witness.
# Set to 1,1,1 to demonstrate the whole loop in three minutes.
ESCALATION_MINUTES=120,120,120
